# Server only. Copy to .env; injected deployment values take precedence.
APP_ENV=local
LISTEN_ADDR=:8080
FIREBASE_PROJECT_ID=orixrideshare
FIREBASE_SERVICE_ACCOUNT_PATH=your-firebase-adminsdk.json
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/?retryWrites=true&w=majority
MONGODB_DATABASE=Orix-Prod
ADMIN_API_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://orixrideshare.tech,https://www.orixrideshare.tech,http://localhost:5173,http://127.0.0.1:5173
ACCOUNT_SUPPORT_EMAIL=Christopherjoshy4@gmail.com
PRIVACY_POLICY_URL=https://orixrideshare.tech/privacy
FIREBASE_WEB_API_KEY=YOUR_PUBLIC_FIREBASE_WEB_KEY
FIREBASE_WEB_AUTH_DOMAIN=orixrideshare.firebaseapp.com
FIREBASE_WEB_APP_ID=YOUR_PUBLIC_FIREBASE_WEB_APP_ID
RATE_LIMIT_PER_MINUTE=60
# Contracted place provider and road router, when provisioned:
GEOCODING_BASE_URL=
GEOCODING_API_TOKEN=
GEOCODING_ATTRIBUTION=
GEOCODING_ATTRIBUTION_URL=
ROUTING_BASE_URL=
# Legacy Python only. Prefer the managed provider's TLS Redis endpoint.
REDIS_URL=rediss://USER:PASSWORD@YOUR_TLS_REDIS_HOST:PORT
JWT_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET
API_BASE_URL=http://127.0.0.1:8080
DEBUG=false
# See Docs/environment-setup.md for deployment and internal test configuration.
